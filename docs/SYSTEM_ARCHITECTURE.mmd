flowchart TB
 subgraph DATA["`**1. Data Ingestion & Harvesting (PrimeKG)**`"]
    direction TB
        PKG[("`**Precision Medicine<br>Knowledge Graph<br>(PrimeKG Repository)**`")]
        NODES["`**Nodes Subset<br>(10,597 Entities)**`"]
        MOL["`**Molecular Features<br>(Physicochemical)**`"]
        EDGES["`**Edges Subset<br>(161,632 Directed)**`"]
  end
 subgraph FEATURE["`**Step I: Feature Pipeline**`"]
    direction TB
        TFIDF["`**TF-IDF Vectorizer<br>(128-dim)**`"]
        SCALER["`**StandardScaler<br>(3-dim)**`"]
        CONCAT["`**Modality Gating Engine<br>(131-dim Tensor)**`"]
  end
 subgraph TOPO["`**Step II: Topology & Sampling**`"]
    direction TB
        UNDIRECTED["`**Bidirectional Adjacency<br>(r + r_rev)**`"]
        SPLIT["`**Disjoint Split<br>(80/10/10)**`"]
        NEG["`**Leakage-Free Masking<br>& Hard Negatives**`"]
  end
 subgraph PRE["`**2. Multimodal Preprocessing & Topology**`"]
    direction LR
        FEATURE
        TOPO
  end
 subgraph TRAIN["`**Step III: GraphSAGE Training**`"]
    direction TB
        GSAGE["`**Inductive GraphSAGE<br>(2-Layer Encoder)**`"]
        LOSS["`**Positive-Unlabeled<br>Loss (L_PU)**`"]
        CHECK["`**Model Checkpoint<br>(Epoch 62 .pth)**`"]
  end
 subgraph DISCOVERY["`**3. Step IV: Discovery Inference**`"]
    direction TB
        EMB["`**Embedding Inference<br>(32-dim)**`"]
        SCORE["`**Cosine Link Decoder<br>(tau = 10.0)**`"]
        TOP50["`**Top Repurposing Leads<br>(Diversity Filtered)**`"]
  end
 subgraph AI["`**Clinical AI & Governance Services**`"]
    direction TB
        OLLAMA["`**Ollama / LLaMA 3.2<br>(Path-Saliency XAI)**`"]
        SAFEGUARDS["`**HIPAA Technical Safeguards<br>(Air-Gap & Audit Ledger)**`"]
  end
 subgraph LAB["`**4. Clinical Discovery Lab Interface (web.py)**`"]
    direction TB
        AI
        DASH["`**Interactive Clinical<br>Dashboard<br>(Streamlit Web UI)**`"]
  end
 subgraph DOWNSTREAM[" "]
    direction LR
        DISCOVERY
        LAB
  end

    PKG --> NODES & MOL & EDGES
