flowchart LR
 subgraph DATA["**1. Data Ingestion &amp; Harvesting (PrimeKG)**"]
    direction TB
        PKG[("`**Precision Medicine<br>Knowledge Graph<br>(PrimeKG Repository)**`")]
        NODES["`**Nodes Subset (CSV)**`"]
        MOL["`**Molecular Features<br>(CSV)**`"]
        EDGES["`**Edges Subset (CSV)**`"]
  end
 subgraph FEATURE["Step I: Feature Pipeline"]
    direction TB
        TFIDF["TF-IDF Vectorizer (128-dim)"]
        SCALER["StandardScaler (3-dim)"]
        CONCAT["Concatenation Engine<br>(131-dim Tensor)"]
  end
 subgraph TOPO["Step II: Topology & Sampling"]
    direction TB
        UNDIRECTED["Undirected Mapping<br>(r + r_rev)"]
        SPLIT["Disjoint Split<br>(80/10/10)"]
        NEG["Collision-Free<br>Neg. Sampling"]
  end
 subgraph PRE["2. Multimodal Preprocessing & Topology"]
    direction LR
        FEATURE
        TOPO
  end
 subgraph TRAIN["Step III: GraphSAGE Training"]
    direction TB
        GSAGE["Hetero GraphSAGE<br>(Encoder-Decoder)"]
        LOSS["BCEWithLogitsLoss"]
        CHECK["Model Checkpoint (.pth)"]
  end
 subgraph DISCOVERY["3. Step IV: Discovery Inference"]
    direction TB
        EMB["Embedding Inference"]
        SCORE["Novel Pair Scoring"]
        TOP50["Top 50<br>Ranked Pairs"]
  end
 subgraph AI["Augmented Intelligence Services"]
    direction TB
        OLLAMA["Ollama / LLaMA 3.2<br>(Mechanistic Reasoning)"]
        APIS["External APIs<br>(PubChem / PubMed)"]
  end
 subgraph LAB["4. Clinical Discovery Lab Interface (web.py)"]
    direction TB
        AI
        DASH["Interactive Clinical<br>Dashboard<br>(Streamlit Web UI)"]
  end
 subgraph DOWNSTREAM[" "]
    direction LR
        DISCOVERY
        LAB
  end
    PKG --> NODES & MOL & EDGES
    TFIDF --> CONCAT
    SCALER --> CONCAT
    UNDIRECTED --> SPLIT
    SPLIT --> NEG
    NODES --> TFIDF
    MOL --> SCALER
    EDGES --> UNDIRECTED
    CONCAT -- "131-dim Multimodal<br>Features &amp; Disjoint<br>Adjacency" --> GSAGE
    NEG -- "131-dim Multimodal<br>Features &amp; Disjoint<br>Adjacency" --> GSAGE
    GSAGE --> LOSS
    LOSS --> CHECK
    EMB --> SCORE
    SCORE --> TOP50
    OLLAMA --> DASH
    APIS --> DASH
    CHECK --> EMB
    TOP50 -- Prioritized Repurposing<br>Candidates --> DASH

